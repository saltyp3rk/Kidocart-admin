{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "public": true,
  "buildCommand": "echo 'done'",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    },
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/products", "destination": "/api/products.js" },
    { "source": "/api/users", "destination": "/api/users.js" },
    { "source": "/api/orders", "destination": "/api/orders.js" },
    { "source": "/api/cart", "destination": "/api/cart.js" },
    { "source": "/api/wishlist", "destination": "/api/wishlist.js" },
    { "source": "/api/addresses", "destination": "/api/addresses.js" },
    { "source": "/api/payment/phonepe/initiate", "destination": "/api/payment/phonepe/initiate.js" },
    { "source": "/api/payment/phonepe/callback", "destination": "/api/payment/phonepe/callback.js" },
    { "source": "/api/payment/razorpay/create-order", "destination": "/api/payment/razorpay/create-order.js" },
    { "source": "/api/payment/razorpay/verify-payment", "destination": "/api/payment/razorpay/verify-payment.js" },
    { "source": "/api/orders/:id/cancel", "destination": "/api/orders/[id]/cancel.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; connect-src 'self' https://api.imgbb.com https://api.razorpay.com https://lumberjack.razorpay.com https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com; img-src 'self' data: https: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://*.razorpay.com https://www.gstatic.com; frame-src 'self' https://api.razorpay.com;" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
