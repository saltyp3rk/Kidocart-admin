{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "echo 'done'",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth/login.js" },
    { "source": "/api/products", "destination": "/api/products/index.js" },
    { "source": "/api/products/:id", "destination": "/api/products/[id].js" },
    { "source": "/api/orders", "destination": "/api/orders/index.js" },
    { "source": "/api/orders/:id", "destination": "/api/orders/[id].js" },
    { "source": "/api/users", "destination": "/api/users/index.js" },
    { "source": "/api/dashboard/stats", "destination": "/api/dashboard/stats.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://api.imgbb.com https://www.kidocart.shop; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://admin.kidocart.shop" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
